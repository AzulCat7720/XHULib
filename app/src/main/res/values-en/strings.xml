    <string name="settings_logout_confirm_title">Sign out?</string>
    <string name="settings_logout_confirm_message">You will be signed out of the current account and its sign-in state will be cleared. The account and password saved on this device will be kept, so next time you only need to enter the verification code.</string>
    <string name="settings_logout_forget">Sign out and delete account on this device</string>
    <string name="settings_logout_forget_desc">Also delete the account and password saved on this device</string>
    <string name="settings_logout_forget_confirm_title">Sign out and delete the account on this device?</string>
    <string name="settings_logout_forget_confirm_message">You will be signed out, and the account and password saved on this device will be deleted. Next time you will need to enter the full account and password again, and this cannot be undone.</string>

